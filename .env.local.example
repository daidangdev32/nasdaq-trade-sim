# ----- Supabase (required) -----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Server-side only. Used by the cron job to bypass RLS when refreshing prices.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ----- Finnhub (required) -----
# Sign up at https://finnhub.io  → free tier = 60 calls/minute
FINNHUB_API_KEY=your_finnhub_api_key

# ----- Anthropic (optional — for AI market insights) -----
ANTHROPIC_API_KEY=sk-ant-...

# ----- Cron secret (required in production) -----
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` — generate any random string.
CRON_SECRET=replace_with_a_long_random_string

# ----- App URL (used in auth callbacks) -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
